<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="top.huyuhao.anime.mapper.AnimeMapper">

    <!-- 搜索已审核通过的动漫 -->
    <select id="search" resultType="top.huyuhao.anime.pojo.Anime">
        select distinct a.*
        from anime a
        <if test="tagId != null">
            inner join anime_tag at on a.id = at.anime_id
        </if>
        <where>
            a.review_status = 'approved'
            <if test="name != null and name != ''">
                and (a.name_cn like concat('%',#{name},'%')
                <if test="name != null and name != ''">
                    or a.name_jp like concat('%',#{name},'%')
                </if>
                )
            </if>
            <if test="tagId != null">
                and at.tag_id = #{tagId}
            </if>
        </where>
        order by a.id desc
    </select>

    <!-- 搜索待审核/审核历史的动漫 -->
    <select id="searchPending" resultType="top.huyuhao.anime.pojo.Anime">
        select *
        from anime
        <where>
            <choose>
                <when test="reviewStatus != null and reviewStatus != ''">
                    review_status = #{reviewStatus}
                </when>
                <otherwise>
                    review_status != 'preparing'
                </otherwise>
            </choose>
            <if test="name != null and name != ''">
                and (name_cn like concat('%',#{name},'%') or name_jp like concat('%',#{name},'%'))
            </if>
        </where>
        order by created_at desc
    </select>

    <!-- 查询当前用户的提交记录 -->
    <select id="searchBySubmitter" resultType="top.huyuhao.anime.pojo.Anime">
        select *
        from anime
        <where>
            submitted_by = #{submittedBy}
            and review_status != 'preparing'
            <if test="reviewStatus != null and reviewStatus != ''">
                and review_status = #{reviewStatus}
            </if>
        </where>
        order by created_at desc
    </select>

</mapper>
